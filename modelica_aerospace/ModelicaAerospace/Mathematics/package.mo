within ModelicaAerospace;
package Mathematics "Mathematical and attitude primitives"
  annotation (Documentation(info="<html>
<p>Compiler-portable vector, matrix, and attitude functions. Quaternions are
scalar-first and represent active rotations from body coordinates to the named
reference frame. Euler angles use the aerospace 3-2-1 yaw-pitch-roll
sequence.</p>
</html>"));
end Mathematics;
