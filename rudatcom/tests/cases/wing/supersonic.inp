 $FLTCON NMACH=4.,MACH(1)=0.6,1.4,2.0,3.5,NALPHA=7.,
 ALSCHD(1)=-4.,0.,2.,4.,8.,12.,16.,RNNUB(1)=3.E6,4.E6,5.E6,6.E6$
 $OPTINS SREF=12.,CBARR=2.2,BLREF=6.$
 $SYNTHS XCG=2.,XW=0.5,ZW=0.,ALIW=1.$
 $WGPLNF CHRDTP=1.,SSPNE=2.8,SSPN=3.,CHRDR=3.,SAVSI=45.,CHSTAT=0.,
 TWISTA=0.,DHDADI=0.,TYPE=1.$
 $WGSCHR TOVC=0.05,DELTAY=1.3,XOVC=0.4,CLI=0.,ALPHAI=0.,CLALPA(1)=0.1,
 CLMAX(1)=0.9,CMO=0.,LERI=0.002,CLAMO=0.1,TCEFF=0.05$
CASEID SWEPT TAPERED WING, ROUND EDGE, SUBSONIC THEN SUPERSONIC EDGE
SAVE
NEXT CASE
 $WGSCHR KSHARP=4.$
CASEID SWEPT TAPERED WING, SHARP EDGE
NEXT CASE
 $FLTCON NMACH=3.,MACH(1)=1.6,3.0,2.0,NALPHA=5.,
 ALSCHD(1)=0.,3.,6.,10.,15.,RNNUB(1)=3.E6,4.E6,5.E6$
 $OPTINS SREF=2.,CBARR=2.,BLREF=1.$
 $SYNTHS XCG=1.,XW=0.$
 $WGPLNF CHRDTP=2.,SSPNE=0.5,SSPN=0.5,CHRDR=2.,SAVSI=0.,CHSTAT=0.,
 TWISTA=0.,TYPE=1.$
 $WGSCHR TOVC=0.04,DELTAY=1.,XOVC=0.5,CLALPA(1)=0.1,CLMAX(1)=0.8,
 LERI=0.001,TCEFF=0.04,KSHARP=5.3$
CASEID RECTANGULAR WING, AR*BETA BELOW AND ABOVE 1
NEXT CASE
 $FLTCON NMACH=3.,MACH(1)=1.6,2.2,4.5,NALPHA=6.,
 ALSCHD(1)=0.,2.,5.,10.,15.,20.,RNNUB(1)=5.E6,6.E6,7.E6$
 $OPTINS SREF=10.,CBARR=4.,BLREF=4.$
 $SYNTHS XCG=3.,XW=0.$
 $WGPLNF CHRDTP=0.,SSPNE=2.,SSPN=2.,CHRDR=5.,SAVSI=70.,CHSTAT=0.,
 TWISTA=0.,TYPE=1.$
 $WGSCHR TOVC=0.03,DELTAY=0.8,XOVC=0.5,CLALPA(1)=0.1,CLMAX(1)=0.8,
 LERI=0.0005,TCEFF=0.03$
CASEID DELTA WING, HIGHLY SWEPT EDGE
NEXT CASE
 $FLTCON NMACH=3.,MACH(1)=1.5,2.5,3.5,NALPHA=5.,
 ALSCHD(1)=0.,4.,8.,12.,16.,RNNUB(1)=3.E6,4.E6,5.E6$
 $OPTINS SREF=20.,CBARR=4.,BLREF=6.$
 $SYNTHS XCG=3.,XW=0.$
 $WGPLNF SSPNOP=1.5,SSPNE=3.,SSPN=3.,CHRDBP=3.,CHRDR=7.,CHRDTP=0.6,
 SAVSI=70.,SAVSO=50.,CHSTAT=0.,TWISTA=0.,TYPE=2.$
 $WGSCHR TOVC=0.05,TOVCO=0.06,XOVCO=0.4,LERI=0.003,LERO=0.004,CMOT=0.,
 DELTAY=1.2,XOVC=0.4,CLALPA(1)=0.1,CLMAX(1)=0.9,TCEFF=0.05$
CASEID DOUBLE DELTA WING
SAVE
NEXT CASE
 $WGPLNF TYPE=3.$
 $WGSCHR KSHARP=4.$
CASEID CRANKED WING, SHARP EDGE
SAVE
NEXT CASE
 $WGPLNF SAVSI=40.,SAVSO=65.,TYPE=2.$
CASEID WING WITH LEADING-EDGE EXTENSION
NEXT CASE
