 $FLTCON NMACH=2.,MACH(1)=0.3,0.6,NALPHA=6.,
 ALSCHD(1)=-4.,0.,4.,8.,12.,16.,RNNUB(1)=3.E6,5.E6$
 $OPTINS SREF=20.,CBARR=2.,BLREF=10.$
 $SYNTHS XCG=1.,XW=0.,ZW=0.$
 $WGPLNF CHRDTP=1.,SSPNE=5.,SSPN=5.,CHRDR=3.,SAVSI=20.,CHSTAT=0.,
 TWISTA=0.,DHDADI=5.,TYPE=1.$
 $WGSCHR TOVC=0.1,DELTAY=2.5,XOVC=0.35,CLI=0.,ALPHAI=0.,CLALPA(1)=0.1,0.1,
 CLMAX(1)=1.2,1.2,CMO=0.,LERI=0.01,CLAMO=0.1$
CASEID FULL SPAN DIHEDRAL
SAVE
NEXT CASE
 $WGPLNF SSPNDD=2.,DHDADI=2.,DHDADO=8.$
CASEID PARTIAL SPAN DIHEDRAL
NEXT CASE
 $FLTCON NMACH=2.,MACH(1)=0.3,0.6,NALPHA=6.,
