 $FLTCON NMACH=2.,MACH(1)=6.,10.,NALPHA=6.,ALSCHD(1)=-4.,0.,4.,8.,16.,24.,
 RNNUB(1)=5.E6,5.E6,HYPERS=.TRUE.$
 $OPTINS SREF=8.,CBARR=2.,BLREF=4.$
 $SYNTHS XCG=4.$
 $BODY NX=8.,X(1)=0.,0.5,1.,2.,4.,6.,8.,10.,
 R(1)=0.,0.3,0.55,0.8,1.,1.,0.9,0.8,BNOSE=2.,BTAIL=2.,BLN=2.,BLA=6.$
CASEID OGIVE NOSE, BOAT TAIL
SAVE
NEXT CASE
 $BODY BNOSE=1.,DS=0.2$
CASEID BLUNTED CONE NOSE
NEXT CASE
 $FLTCON NMACH=2.,MACH(1)=6.,10.,NALPHA=5.,ALSCHD(1)=-2.,0.,2.,6.,12.,
 RNNUB(1)=5.E6,5.E6,HYPERS=.TRUE.$
