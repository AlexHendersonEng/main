within ModelicaAerospace.Environment;
package Wind "Wind, gust and turbulence models"
  annotation (Documentation(info="<html>
<p>Steady wind, linear shear, one-minus-cosine gusts, deterministic seeded
broadband forcing, and low-altitude Dryden shaping filters. Wind vectors use
NED axes and turbulence velocities use body axes.</p>
</html>"));
end Wind;
