within ModelicaMaritime.Environment;
package Waves "Deterministic regular and spectral wave models"
  annotation (Documentation(info="<html>
<p>Deep-water regular-wave kinematics and finite-component deterministic
irregular waves based on Pierson-Moskowitz, JONSWAP, and Bretschneider
spectra. Frequencies are in hertz and directions are toward wave travel,
clockwise from north.</p>
</html>"));
end Waves;
