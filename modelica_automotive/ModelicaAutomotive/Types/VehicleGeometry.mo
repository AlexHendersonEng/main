within ModelicaAutomotive.Types;
record VehicleGeometry "Passenger-vehicle reference geometry"
  ModelicaAutomotive.Types.Length wheelbase = 2.7;
  ModelicaAutomotive.Types.Length frontTrack = 1.6;
  ModelicaAutomotive.Types.Length rearTrack = 1.6;
  ModelicaAutomotive.Types.Length centerOfMassToFrontAxle = 1.2;
  ModelicaAutomotive.Types.Length centerOfMassHeight = 0.55;
end VehicleGeometry;
