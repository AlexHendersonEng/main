DIM FT
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=2.,ALSCHD(1)=0.,5.,
 RNNUB(1)=1000000., ALT(1)=1000., PINF(1)=100., TINF(1)=280.,
 VINF(1)=100., WT=200.$
 $GRNDEF NGH=1.,GRDHT(1)=10.$
 $OPTINS SREF=120., CBARR=4., BLREF=25., ROUGFC=0.002$
 $BODY NX=5., X(1)=2.,5.,8.,11.,14., R(1)=0.2,1.,1.,0.8,0.2$
 $SYNTHS XCG=7.,XW=4.,ZW=0.3,ALIW=5.,XH=11.,ZH=1.,ALIH=4.,
 HINAX=10.,XV=11.,ZV=0.5,XVF=10.,ZVF=-1.,SCALE=1.3$
 $WGPLNF CHRDR=5.,CHRDTP=1.,SSPN=6.,SSPNE=5.,CHSTAT=0.25,
 SAVSI=-15.,SSPNDD=3.,DHDADI=2.,DHDADO=5.,TYPE=1.$
 $WGSCHR XOVC=0.3,ARCL=3.2$
 $HTPLNF CHRDR=3.,CHRDTP=1.,SSPN=4.,SSPNE=3.5,CHSTAT=0.25,
 SAVSI=20.,RLPH(1)=2.,SHB(1)=3.,SEXT(1)=4.,TYPE=1.$
 $HTSCHR XOVC=0.25$
 $VTPLNF CHRDR=3.,CHRDTP=1.,SSPN=3.,SSPNE=2.5,CHSTAT=0.25,
 SAVSI=15.,SVWB(1)=2.,SVB(1)=3.,SVHB(1)=4.$
 $VTSCHR XOVC=0.4$
 $VFPLNF CHRDR=2.,CHRDTP=0.5,SSPN=2.,SSPNE=1.5,CHSTAT=0.25,
 SAVSI=35.$
 $VFSCHR XOVC=0.35$
 $VTPLNF SAVSI=25.$
CASEID FEET SCALE OFFSET HINGE AND INDEPENDENT FIN SWEEPS
NEXT CASE
DIM IN
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,
 RNNUB(1)=1000000., ALT(1)=1000., PINF(1)=100., TINF(1)=280.,
 VINF(1)=100., WT=200.$
 $SYNTHS XCG=7.,XW=4.,ZW=0.3,ALIW=-3.,SCALE=0.7$
 $WGPLNF CHRDR=6.,CHRDBP=3.,CHRDTP=1.,SSPN=7.,SSPNE=6.,
 SSPNOP=3.,CHSTAT=0.,SAVSI=35.,SAVSO=-10.,TYPE=2.$
 $WGSCHR XOVC=0.3,XOVCO=0.4$
CASEID INCHES DOUBLE DELTA PLANFORM
NEXT CASE
DIM M
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,
 RNNUB(1)=1000000., ALT(1)=1000., PINF(1)=100., TINF(1)=280.,
 VINF(1)=100., WT=200.$
 $SYNTHS XCG=7.,XW=4.,ZW=0.3,ALIW=0.,SCALE=2.$
 $WGPLNF CHRDR=6.,CHRDBP=3.,CHRDTP=0.,SSPN=7.,SSPNE=6.,
 SSPNOP=3.,CHSTAT=1.,SAVSI=40.,SAVSO=20.,TYPE=3.$
 $WGSCHR XOVC=0.3,XOVCO=0.4$
CASEID METERS CRANKED PLANFORM
NEXT CASE
DIM CM
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,
 RNNUB(1)=1000000., ALT(1)=1000., PINF(1)=100., TINF(1)=280.,
 VINF(1)=100., WT=200.$
 $BODY NX=3.,X(1)=2.,5.,8.,R(1)=0.,1.,0.$
 $SYNTHS XCG=7.,XW=4.,ZW=0.3,ALIW=0.,SCALE=0.3$
 $WGPLNF CHRDR=5.,CHRDTP=2.,SSPN=6.,SSPNE=5.,CHSTAT=0.,
 SAVSI=-30.,TYPE=1.$
 $WGSCHR XOVC=0.3$
CASEID CENTIMETERS NEGATIVE SWEEP AND NONZERO NOSE
NEXT CASE
DIM M
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,RNNUB(1)=1.E6$
 $SYNTHS SCALE=2.$
 $LARWB SREF=0.989,L=1.915,AR=1.076,SFRONT=0.307,SWET=2.28$
CASEID LARWB REFERENCES APPLY MODEL SCALE
NEXT CASE
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,RNNUB(1)=1.E6$
 $SYNTHS SCALE=0.5$
 $LARWB SREF=0.989,L=1.915,AR=1.076,SFRONT=0.307,SWET=2.28$
 $OPTINS SREF=4.,CBARR=3.$
CASEID OPTINS AFTER LARWB OVERRIDES REFERENCES
NEXT CASE
DIM FT
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,RNNUB(1)=1.E6$
 $BODY NX=3.,X(1)=2.,5.,8.,R(1)=0.,1.,0.$
 $SYNTHS XCG=4.,XH=7.,ZH=0.2,ALIH=10.,HINAX=6.$
 $HTPLNF CHRDR=2.,CHRDTP=1.,SSPN=3.,SSPNE=2.,CHSTAT=0.25,SAVSI=20.$
 $HTSCHR XOVC=0.3$
CASEID BODY AND HORIZONTAL TAIL WITHOUT WING
NEXT CASE
DIM IN
 $FLTCON NMACH=1.,MACH(1)=0.4,NALPHA=1.,ALSCHD(1)=0.,RNNUB(1)=1.E6$
 $SYNTHS SCALE=0.5$
 $WGPLNF CHRDR=24.,CHRDTP=12.,SSPN=48.,SSPNE=36.,CHSTAT=0.25$
 $WGSCHR XOVC=0.3$
 $SYMFLP NDELTA=2.,DELTA(1)=0.,10.,CHRDFI=4.,CHRDFO=2.,
 SPANFI=6.,SPANFO=24.,FTYPE=1.$
CASEID SYMMETRIC FLAP CONVERSION AND BODY-WIDTH CLAMP
NEXT CASE
